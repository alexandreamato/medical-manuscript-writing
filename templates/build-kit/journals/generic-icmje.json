      {
        "id": "introduction",
        "heading": "Introduction"
      },
      {
        "id": "methods",
        "heading": "Methods"
      },
      {
        "id": "results",
        "heading": "Results"
      },
      {
        "id": "discussion",
        "heading": "Discussion"
      }
    ],
    "limit": {
      "unit": "words",
      "max": 3500,
      "count_sections": [
        "introduction",
        "methods",
        "results",
        "discussion"
      ],
      "include_floats": false
    }
  },
  "section_limits": {},
  "references": {
    "max": null,
    "require_identifier": false
  },
  "figures": {
    "max": null,
    "placement": "inline"
  },
  "tables": {
    "max": null,
    "placement": "inline"
  },
  "figures_tables_max": null,
  "required_declarations": [
    "ethics",
    "funding",
    "conflicts",
    "data-availability",
    "author-contributions",
    "ai-use"
